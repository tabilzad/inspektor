            "deprecated" : true
          }
        },
        "required" : [ "id" ]
      },
      "sources.LegacyPayload" : {
        "type" : "object",
        "properties" : {
          "amount" : {
            "type" : "integer"
          },
          "id" : {
            "type" : "string"
          }
        },
        "description" : "A legacy payload kept for old clients.\n\nDeprecated: Use CurrentPayload instead",
